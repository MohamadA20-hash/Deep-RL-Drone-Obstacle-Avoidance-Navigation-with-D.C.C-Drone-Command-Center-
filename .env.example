# =============================================================
# Drone Command Center — environment variable template
# Copy this file to `.env` and adjust the values for your setup.
#   PowerShell:   Copy-Item .env.example .env
#   bash:         cp .env.example .env
# `.env` is git-ignored — never commit real secrets.
# =============================================================

# ---------- PostgreSQL (used by docker-compose) ----------
DB_NAME=drone_command_center
DB_USERNAME=postgres
DB_PASSWORD=change_me_strong_password
DB_PORT=5432

# ---------- Backend (Spring Boot) ----------
BACKEND_PORT=8080
# Base64-encoded HMAC key, >= 32 bytes when decoded. Generate a fresh one:
#   openssl rand -base64 48
JWT_SECRET=Qm9iVGhlRHJvbmVDb21tYW5kQ2VudGVyU2VjdXJlS2V5MTIzNDU2Nzg5MDE=

# ---------- AirSim Python bridge ----------
# These credentials must match a real user account in the backend.
# Create the user via the frontend's "Register" screen on first run.
BRIDGE_AUTH_USER=navrl_bridge
BRIDGE_AUTH_PASS=NavRL@2026!

# Where the bridge reaches the backend (host -> container)
BRIDGE_BACKEND_URL=http://localhost:8080/api
BRIDGE_WS_URL=ws://localhost:8080/ws/telemetry

# AirSim simulator (default: same machine)
BRIDGE_AIRSIM_HOST=127.0.0.1
BRIDGE_AIRSIM_PORT=41451

# Bridge tuning (optional — defaults are sane)
BRIDGE_TELEMETRY_INTERVAL=0.05
BRIDGE_POLL_INTERVAL=3.0
BRIDGE_NAV_CHECK_INTERVAL=3.0
FPV_PORT=8766

# ---------- Frontend (Flutter) ----------
# The dashboard reads these via --dart-define at launch time.
# See README.md "Run the frontend" section for the exact flutter command.
FRONTEND_API_BASE_URL=http://localhost:8080
FRONTEND_WS_URL=ws://localhost:8080/ws/telemetry
